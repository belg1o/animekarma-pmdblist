# Copy to .env (chmod 600 .env). Never commit the real file.

# --- PublicMetaDB (optional) ---
PMDB_API_KEY=
PMDB_LIST_ID=               # karma list (PMDB_LIST_ID_KARMA also works)
PMDB_LIST_ID_RECENT=
PMDB_LIST_ID_POPULAR=
PMDB_LIST_ID_TRENDING=

# --- MDBList (optional; static lists) ---
MDBLIST_API_KEY=
MDBLIST_LIST_ID_KARMA=
MDBLIST_LIST_ID_RECENT=
MDBLIST_LIST_ID_POPULAR=
MDBLIST_LIST_ID_TRENDING=

# A job runs on every service that has a list id for it. Each job needs its OWN list on each
# service: a run replaces the list's entire contents.

# --- optional switches ---
# Kuroiru recent/popular/trending: leave blank to disable each filter.
# Example: MIN_MEMBERS=10000 and MIN_SCORE=7.0
MIN_MEMBERS=
MIN_SCORE=
# MIN_KARMA=200   WINDOW_DAYS=7   VERIFY_DAYS=7   STATE_FILE=/path/sync_state.json
# DRY_RUN=1 (read-only)   FORCE=1 (ignore the local cache)
